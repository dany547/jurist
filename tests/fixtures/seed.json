  "provisions": [
    {"id": "EU:REG:2016:679:ART:1", "act_id": "EU:REG:2016:679", "article": "1", "provision_type": "article", "text": "Prezentul regulament stabilește norme referitoare la protecția persoanelor fizice în ceea ce privește prelucrarea datelor cu caracter personal și norme referitoare la libera circulație a acestor date.", "domains": ["personal_data", "privacy"], "valid_from": "2016-05-04", "citable": 1},
    {"id": "EU:REG:2016:679:ART:2", "act_id": "EU:REG:2016:679", "article": "2", "provision_type": "article", "text": "Prezentul regulament se aplică prelucrării datelor cu caracter personal efectuate total sau parțial prin mijloace automatizate.", "domains": ["privacy"], "valid_from": "2016-05-04", "citable": 1},
    {"id": "EU:REG:2016:679:ART:6", "act_id": "EU:REG:2016:679", "article": "6", "provision_type": "article", "text": "Prelucrarea este legală numai dacă și în măsura în care se aplică cel puțin una dintre următoarele condiții.", "domains": ["temeiuri_legale", "interes_legitim"], "valid_from": "2016-05-04", "citable": 1},
    {"id": "EU:REG:2016:679:ART:7", "act_id": "EU:REG:2016:679", "article": "7", "provision_type": "article", "text": "În cazul în care prelucrarea se bazează pe consimțământ, operatorul trebuie să poată demonstra că persoana vizată și-a dat consimțământul.", "domains": ["consimtamant"], "valid_from": "2016-05-04", "citable": 1},
    {"id": "EU:REG:2016:679:REC:32", "act_id": "EU:REG:2016:679", "article": "32", "provision_type": "recital", "text": "Consimțământul ar trebui dat printr-o declarație sau acțiune afirmativă clară, fără echivoc.", "domains": ["consimtamant"], "valid_from": "2016-05-04", "citable": 0},
    {"id": "EU:DIR:2002:58:ART:5:P:3", "act_id": "EU:DIR:2002:58", "article": "5", "paragraph": "3", "provision_type": "article", "text": "Stocarea de informații sau obținerea accesului la informațiile deja stocate în echipamentul terminal al unui abonat sau utilizator este permisă numai cu consimțământ.", "domains": ["cookies"], "valid_from": "2002-07-12", "citable": 1},
    {"id": "EU:DIR:2011:83:ART:9", "act_id": "EU:DIR:2011:83", "article": "9", "provision_type": "article", "text": "Cu excepția cazurilor prevăzute la articolul 16, consumatorul dispune de o perioadă de paisprezece zile pentru a se retrage dintr-un contract la distanță.", "domains": ["retragere", "consumer"], "valid_from": "2011-10-25", "citable": 1},
    {"id": "EU:DIR:2005:29:ART:5", "act_id": "EU:DIR:2005:29", "article": "5", "provision_type": "article", "text": "Practicile comerciale neloiale sunt interzise.", "domains": ["practici_incorecte", "consumer"], "valid_from": "2005-06-11", "citable": 1},
    {"id": "RO:LEGE:190:2018:ART:3", "act_id": "RO:LEGE:190:2018", "article": "3", "provision_type": "article", "text": "Prelucrarea datelor cu caracter personal în contextul ocupării unui loc de muncă se realizează cu respectarea condițiilor prevăzute de regulament.", "domains": ["personal_data", "employment"], "valid_from": "2018-07-18", "citable": 1},
    {"id": "RO:LEGE:506:2004:ART:4:P:5", "act_id": "RO:LEGE:506:2004", "article": "4", "paragraph": "5", "provision_type": "article", "text": "Stocarea de informaţii sau obţinerea accesului la informaţiile stocate în echipamentul terminal al abonatului este permisă numai cu acordul acestuia.", "domains": ["cookies", "consimtamant"], "valid_from": "2004-11-17", "citable": 1},
    {"id": "RO:LEGE:365:2002:ART:5", "act_id": "RO:LEGE:365:2002", "article": "5", "provision_type": "article", "text": "Furnizorul de servicii are obligația de a pune la dispoziția destinatarilor și autorităților competente informații privind numele și sediul său.", "domains": ["ecommerce", "commercial_information"], "valid_from": "2002-06-07", "citable": 1},
    {"id": "RO:OUG:34:2014:ART:9", "act_id": "RO:OUG:34:2014", "article": "9", "provision_type": "article", "text": "Consumatorul beneficiază de o perioadă de 14 zile pentru a se retrage din contractul la distanță fără a fi nevoit să justifice decizia de retragere.", "domains": ["retragere", "consumer"], "valid_from": "2014-06-13", "citable": 1},
    {"id": "RO:LEGE:193:2000:ART:1", "act_id": "RO:LEGE:193:2000", "article": "1", "provision_type": "article", "text": "Orice contract încheiat între comercianți și consumatori pentru vânzarea de bunuri sau prestarea de servicii trebuie să cuprindă clauze contractuale clare.", "domains": ["clauze_abuzive", "consumer"], "valid_from": "2000-11-06", "citable": 1}
  ],
